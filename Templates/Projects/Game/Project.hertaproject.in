  "targets": [{"name": "{{ModuleName}}Editor", "type": "Editor", "modules": ["{{ModuleName}}"]}],
  "contentRoots": [{"name": "Game", "path": "Content"}],
  "features": [],
  "startingLevel": "Levels/Main.hlevel"
}

#include "{{ModuleName}}Game.h"

namespace Herta
{
namespace
{
// Greets the first player once. Replace it with the game's own systems.
class FWelcomeSystem final : public IGameSystem
{
public:
	void Update(IGameSystemContext& Context, float DeltaSeconds) override;

private:
	bool bWelcomed = false;
};

void FWelcomeSystem::Update(IGameSystemContext& Context, float)
{
	if (!bWelcomed && Context.GetPlayerCount() > 0)
	{
		bWelcomed = true;
		Context.Log("Welcome to {{ProjectName}}");
	}
}

std::unique_ptr<IGameSystem> CreateWelcomeSystem()
{
	return std::make_unique<FWelcomeSystem>();
}
}

void Register{{ModuleName}}(IGameModuleRegistry& Registry)
{
	Registry.AddSystem("Welcome", CreateWelcomeSystem);
}
}

HERTA_GAME_MODULE(Herta::Register{{ModuleName}})

    {"key": "Prefs.BlurHint", "text": "Backdrop blur behind transparent panels.", "comment": "Hint under the Blur setting."},
    {"key": "Prefs.Calibrate", "text": "Calibrate peak", "comment": "Display setting."},
    {"key": "Prefs.CalibrateHint", "text": "Shows a test pattern in the level viewport. Raise Peak brightness until the inner square disappears.", "comment": "Hint under the Calibrate peak setting."},
    {"key": "Prefs.Color", "text": "Color", "comment": "Appearance heading."},
    {"key": "Prefs.Display", "text": "Display", "comment": "Preferences tab section."},
    {"key": "Prefs.DockedPanels", "text": "Docked panels", "comment": "Transparency choice."},
    {"key": "Prefs.Editor", "text": "Editor", "comment": "Preferences tab section group heading."},
    {"key": "Prefs.FloatingPanels", "text": "Floating panels", "comment": "Transparency choice."},
    {"key": "Prefs.GradientHeight", "text": "Gradient height", "comment": "Appearance setting."},
    {"key": "Prefs.GradientHeightHint", "text": "How far the accent tint reaches down the window.", "comment": "Hint under the Gradient height setting."},
    {"key": "Prefs.Hdr", "text": "HDR", "comment": "Display heading."},
    {"key": "Prefs.HdrOutput", "text": "HDR output", "comment": "Display setting."},
    {"key": "Prefs.HdrOutputHint", "text": "Present the editor in HDR10.", "comment": "Hint under the HDR output setting."},
    {"key": "Prefs.HdrUnavailable", "text": "This display does not offer HDR10. On Windows, turn on Use HDR in display settings.", "comment": "Hint under HDR output when the display has no HDR10."},
    {"key": "Prefs.Intensity", "text": "Intensity", "comment": "Appearance setting."},
    {"key": "Prefs.IntensityHint", "text": "How strongly the tint shows over the dark frame.", "comment": "Hint under the Intensity setting."},
    {"key": "Prefs.Opacity", "text": "Opacity", "comment": "Appearance setting."},
    {"key": "Prefs.OpacityHint", "text": "How solid a transparent panel is.", "comment": "Hint under the Opacity setting."},
    {"key": "Prefs.OpaquePanels", "text": "Opaque panels", "comment": "Transparency choice."},
    {"key": "Prefs.Panels", "text": "Panels", "comment": "Appearance heading."},
    {"key": "Prefs.PaperWhite", "text": "Paper white", "comment": "Display setting."},
    {"key": "Prefs.PaperWhiteHint", "text": "Brightness of white in the editor and of a white surface in the scene.", "comment": "Hint under the Paper white setting."},
    {"key": "Prefs.PeakBrightness", "text": "Peak brightness", "comment": "Display setting."},
    {"key": "Prefs.PeakBrightnessHint", "text": "The brightest highlight the display shows.", "comment": "Hint under the Peak brightness setting."},
    {"key": "Prefs.Presentation", "text": "Presentation", "comment": "Display heading."},
    {"key": "Prefs.Reset", "text": "Reset", "comment": "Button that restores the default appearance."},
    {"key": "Prefs.ResetTip", "text": "Restore the default appearance", "comment": "Tooltip of the appearance Reset button."},
    {"key": "Prefs.Saturation", "text": "Saturation", "comment": "Appearance setting."},
    {"key": "Prefs.SaturationHint", "text": "How vivid the tint is.", "comment": "Hint under the Saturation setting."},
    {"key": "Prefs.SystemValues", "text": "System values", "comment": "Display setting."},
    {"key": "Prefs.SystemValuesHint", "text": "Follow the brightness the operating system reports for this display.", "comment": "Hint under System values when the system reports a brightness."},
    {"key": "Prefs.SystemValuesMissing", "text": "The operating system reports no brightness here, so 200 and 1000 nits apply.", "comment": "Hint under System values when the system reports no brightness."},
    {"key": "Prefs.Transparency", "text": "Transparency", "comment": "Appearance setting."},
    {"key": "Prefs.TransparencyHint", "text": "Which panels let the scene show through.", "comment": "Hint under the Transparency setting."},
    {"key": "Prefs.UseSystemValues", "text": "Use system values", "comment": "Button that returns HDR brightness to the system values."},
    {"key": "Prefs.VSyncHint", "text": "Present frames in step with the display's refresh.", "comment": "Hint under the VSync setting."},

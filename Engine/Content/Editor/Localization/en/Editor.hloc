    {"key": "ProjectSettings.DescriptorHint", "text": "The file these settings are saved to.", "comment": "Hint under Descriptor."},
    {"key": "ProjectSettings.Engine", "text": "Engine", "comment": "Read-only project value."},
    {"key": "ProjectSettings.EngineHint", "text": "The engine checkout this project builds against.", "comment": "Hint under Engine."},
    {"key": "ProjectSettings.GameModules", "text": "Game modules", "comment": "Modules heading."},
    {"key": "ProjectSettings.General", "text": "General", "comment": "Project settings tab section."},
    {"key": "ProjectSettings.Heading", "text": "Project", "comment": "Project settings tab section group heading."},
    {"key": "ProjectSettings.Id", "text": "Project ID", "comment": "Read-only project value."},
    {"key": "ProjectSettings.IdHint", "text": "Stable identity, written when the project was created.", "comment": "Hint under Project ID."},
    {"key": "ProjectSettings.Identity", "text": "Identity", "comment": "General heading."},
    {"key": "ProjectSettings.Modules", "text": "Modules", "comment": "Project settings tab section."},
    {"key": "ProjectSettings.Name", "text": "Name", "comment": "Project setting."},
    {"key": "ProjectSettings.NameHint", "text": "Shown in the title bar and in packaged builds.", "comment": "Hint under the project Name."},
    {"key": "ProjectSettings.NoProject", "text": "No project is open. The level was opened on its own.", "comment": "Shown in Project settings when a level is open without a project."},

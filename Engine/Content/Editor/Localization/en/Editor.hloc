    {"key": "Plugins.Search", "text": "Search plugins", "comment": "Placeholder in the Plugins search field."},
    {"key": "Plugins.Show", "text": "Show", "comment": "Plugins tab section group heading."},
    {"key": "Plugins.Source", "text": "Source", "comment": "Plugins tab section group heading."},

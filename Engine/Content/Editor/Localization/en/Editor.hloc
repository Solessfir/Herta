    {"key": "ProjectSettings.ContentPathMissing", "text": "The content folder {path} does not exist.", "comment": "Error when the chosen content folder does not exist; path is the folder."},
    {"key": "ProjectSettings.ContentRootHint", "text": "Mounted under this name in the Content Browser.", "comment": "Hint under a content root."},
    {"key": "ProjectSettings.ContentRoots", "text": "Content roots", "comment": "Content heading."},
    {"key": "ProjectSettings.Dependencies", "text": "Engine modules whose headers it includes.", "comment": "Hint under a game module; the toggles pick the engine modules whose headers it may include."},

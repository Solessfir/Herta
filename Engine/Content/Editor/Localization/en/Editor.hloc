    {"key": "ProjectSettings.Save", "text": "Save", "comment": "Button that writes the project descriptor."},
    {"key": "ProjectSettings.StartingLevel", "text": "Starting level", "comment": "Project setting."},
    {"key": "ProjectSettings.StartingLevelHint", "text": "Opened by the editor and played first by the game, relative to the project.", "comment": "Hint under the Starting level."},
    {"key": "ProjectSettings.TargetModules", "text": "Game modules this target builds.", "comment": "Hint under a build target; the toggles pick the game modules it builds."},
    {"key": "ProjectSettings.TargetName", "text": "Name", "comment": "Field label for a build target name."},
    {"key": "ProjectSettings.Targets", "text": "Targets", "comment": "Project settings tab section."},

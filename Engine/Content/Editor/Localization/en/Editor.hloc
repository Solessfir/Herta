    {"key": "Language.Name", "text": "English", "comment": "The language's own name, shown in the Language menu."},
    {"key": "Localization.Culture", "text": "Translation", "comment": "Label of the culture picker in the Localization panel."},
    {"key": "Localization.Invalid", "text": "Not used: {error}", "comment": "Shown under a translation that does not compile or uses other arguments; error is the reason."},
    {"key": "Localization.Key", "text": "Key", "comment": "Table column."},
    {"key": "Localization.MissingOnly", "text": "Untranslated only", "comment": "Filter toggle in the Localization panel."},
    {"key": "Localization.Preview", "text": "Preview", "comment": "Table column with the translation formatted with sample arguments."},
    {"key": "Localization.Reloaded", "text": "Reloaded {count, plural, one {# text catalog} other {# text catalogs}}", "comment": "Log line when catalogs change on disk; count is how many loaded."},
    {"key": "Localization.Revert", "text": "Revert", "comment": "Button that drops unsaved edits."},
    {"key": "Localization.Save", "text": "Save", "comment": "Button that writes the edited catalog."},
    {"key": "Localization.Saved", "text": "Saved {file}", "comment": "Status after saving; file is a path."},
    {"key": "Localization.Search", "text": "Search keys and text", "comment": "Search hint in the Localization panel."},
    {"key": "Localization.Source", "text": "Source", "comment": "Table column with the English source text."},
    {"key": "Localization.Summary", "text": "{missing, plural, =0 {All translated} one {# untranslated} other {# untranslated}}    {errors, plural, =0 {no errors} one {# error} other {# errors}}", "comment": "Status line; missing and errors are counts."},
    {"key": "Localization.Translation", "text": "Translation", "comment": "Table column."},
    {"key": "Localization.Unsaved", "text": "Unsaved changes", "comment": "Shown while the catalog has unsaved edits."},
    {"key": "Log.All", "text": "All", "comment": "Output Log chip showing every level."},
    {"key": "Log.Errors", "text": "Errors {count}", "comment": "Output Log chip showing only errors; count is how many."},
    {"key": "Log.Warnings", "text": "Warnings {count}", "comment": "Output Log chip showing only warnings; count is how many."},
    {"key": "Menu.BottomPanel", "text": "Bottom panel", "comment": "View menu toggle for the panel area under the viewport."},

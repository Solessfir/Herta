#pragma once

struct FVisualLight
{
    float4 PositionType;
    float4 DirectionRange;
    float4 ColorIntensity;
    float4 RightWidth;
    float4 UpHeight;
    float4 ConeShadow;
};

struct FShadow
{
    column_major float4x4 WorldToClip;
    float4 Atlas;
    float4 Parameters;
};

struct FMaterial
{
    float4 BaseColor;
    float4 Surface;
    float4 Emissive;
    float4 UV;
    float4 Channels0;
    float4 Channels1;
    float4 TextureFlags;
};

struct FVisualUniforms
{
    column_major float4x4 ViewToWorld;
    column_major float4x4 ClipToView;
    float4 Viewport;
    float4 Sky;
    float4 SkyColor;
    float4 Atmosphere;
    float4 AtmosphereGeometry;
    float4 Fog;
    float4 FogColor;
    float4 Controls;
    FVisualLight Lights[32];
    FShadow Shadows[16];
    FMaterial Material;
};

[[vk::binding(64, 0)]] ConstantBuffer<FVisualUniforms> Visual;
[[vk::binding(128, 0)]] SamplerState LinearSampler;
static const float PI = 3.14159265358979323846;

float2 DirectionUV(float3 Direction)
{
    Direction = normalize(Direction);
    return float2(frac(atan2(Direction.z, Direction.x) / (2.0 * PI) + 0.5), acos(clamp(Direction.y, -1.0, 1.0)) / PI);
}

float3 CameraRay(float2 UV)
{
    float4 View = mul(Visual.ClipToView, float4(UV.x * 2.0 - 1.0, 1.0 - UV.y * 2.0, 0.0001, 1.0));
    return normalize(mul((float3x3)Visual.ViewToWorld, View.xyz / View.w));
}

float3 WorldPosition(float2 UV, float Depth)
{
    float4 View = mul(Visual.ClipToView, float4(UV.x * 2.0 - 1.0, 1.0 - UV.y * 2.0, Depth, 1.0));
    return mul(Visual.ViewToWorld, float4(View.xyz / View.w, 1.0)).xyz;
}

// Keep in sync with ProceduralSky in EnvironmentLighting.cpp, which bakes the same sky for image-based lighting.
// Distances are kilometres; scale heights and the ozone layer follow the authored atmosphere height.
float3 SkyExtinction(float3 Position, float PlanetRadius, float HeightScale, out float Rayleigh, out float Mie)
{
    float Height = max(0.0, length(Position) - PlanetRadius);
    Rayleigh = exp(-Height / (8.0 * HeightScale));
    Mie = exp(-Height / (1.2 * HeightScale));
    float Ozone = max(0.0, 1.0 - abs(Height - 25.0 * HeightScale) / (15.0 * HeightScale));
    return float3(5.802e-3, 13.558e-3, 33.1e-3) * Visual.Atmosphere.x * Rayleigh + 3.996e-3 / 0.9 * Visual.Atmosphere.y * Mie + float3(0.65e-3, 1.881e-3, 0.085e-3) * Ozone;
}

float SkyExit(float3 Position, float3 Direction, float Radius)
{
    float B = dot(Position, Direction);
    float C = dot(Position, Position) - Radius * Radius;
    return -B + sqrt(max(0.0, B * B - C));
}

void FindSkySun(out float3 Direction, out float3 Illuminance)
{
    Direction = float3(0.0, 1.0, 0.0);
    Illuminance = 50000.0;
    for (int I = 0; I < int(Visual.Controls.x); ++I)
    {
        if (int(Visual.Lights[I].PositionType.w) == 0)
        {
            Direction = -Visual.Lights[I].DirectionRange.xyz;
            Illuminance = Visual.Lights[I].ColorIntensity.rgb * Visual.Lights[I].ColorIntensity.w;
            return;
        }
    }
}

// Single-scattering Rayleigh, Mie, and ozone radiance along an upper-hemisphere ray from sea level, and its transmittance.
float3 SkyScattering(float3 View, out float3 Transmittance)
{
    float3 SunDirection;
    float3 SunIlluminance;
    FindSkySun(SunDirection, SunIlluminance);
    float PlanetRadius = Visual.AtmosphereGeometry.x / 1000.0;
    float HeightScale = Visual.AtmosphereGeometry.y / 80000.0;
    float AtmosphereRadius = PlanetRadius + Visual.AtmosphereGeometry.y / 1000.0;
    float3 Origin = float3(0.0, PlanetRadius + 0.001, 0.0);
    float Length = SkyExit(Origin, View, AtmosphereRadius);
    float Mu = dot(View, SunDirection);
    float G = Visual.Atmosphere.z;
    float RayleighPhase = 3.0 / (16.0 * PI) * (1.0 + Mu * Mu);
    float MiePhase = (1.0 - G * G) / (4.0 * PI * pow(max(1e-4, 1.0 + G * G - 2.0 * G * Mu), 1.5));
    float3 ViewDepth = 0.0;
    float3 Single = 0.0;
    float3 Multiple = 0.0;
    const int Steps = 12;
    const int SunSteps = 4;
    for (int S = 0; S < Steps; ++S)
    {
        // Quadratic spacing concentrates samples in the dense air near the viewer.
        float Start = float(S * S) / float(Steps * Steps);
        float End = float((S + 1) * (S + 1)) / float(Steps * Steps);
        float Segment = Length * (End - Start);
        float3 Position = Origin + View * (Length * (Start + End) * 0.5);
        float Rayleigh, Mie;
        float3 Extinction = SkyExtinction(Position, PlanetRadius, HeightScale, Rayleigh, Mie) * Segment;
        float3 ViewTransmittance = exp(-(ViewDepth + 0.5 * Extinction));
        ViewDepth += Extinction;
        float B = dot(Position, SunDirection);
        if (B < 0.0 && B * B - dot(Position, Position) + PlanetRadius * PlanetRadius > 0.0) continue;
        float SunLength = SkyExit(Position, SunDirection, AtmosphereRadius);
        float3 SunDepth = 0.0;
        for (int L = 0; L < SunSteps; ++L)
        {
            float SunRayleigh, SunMie;
            SunDepth += SkyExtinction(Position + SunDirection * (SunLength * (float(L) + 0.5) / float(SunSteps)), PlanetRadius, HeightScale, SunRayleigh, SunMie);
        }

        float3 Lit = ViewTransmittance * exp(-SunDepth * (SunLength / float(SunSteps))) * Segment;
        float3 RayleighScattering = float3(5.802e-3, 13.558e-3, 33.1e-3) * Visual.Atmosphere.x * Rayleigh;
        float MieScattering = 3.996e-3 * Visual.Atmosphere.y * Mie;
        Single += Lit * (RayleighScattering * RayleighPhase + MieScattering * MiePhase);
        Multiple += Lit * (RayleighScattering + MieScattering) / (4.0 * PI);
    }

    Transmittance = exp(-ViewDepth);
    // Single scattering alone underexposes skylight; the isotropic term and gain approximate multiple scattering at the previous sky's zenith brightness.
    return (Single + Multiple) * 2.0 * SunIlluminance;
}

// The sky-view table covers the upper hemisphere; latitude is square-root mapped so the horizon band gets most rows.
float2 SkyViewUV(float3 View)
{
    return float2(atan2(View.z, View.x) / (2.0 * PI) + 0.5, sqrt(saturate(asin(saturate(View.y)) / (0.5 * PI))));
}

float3 SkyViewDirection(float2 UV)
{
    float Latitude = UV.y * UV.y * 0.5 * PI;
    float Azimuth = (UV.x - 0.5) * 2.0 * PI;
    return float3(cos(Latitude) * cos(Azimuth), sin(Latitude), cos(Latitude) * sin(Azimuth));
}

// The lower hemisphere mirrors the sky and darkens, reading as distant haze rather than a flat ground plane.
float3 ComposeProceduralSky(float3 Direction, float3 MirroredScattering)
{
    float3 Radiance = MirroredScattering * (Direction.y < 0.0 ? 1.0 - 0.7 * sqrt(saturate(-Direction.y)) : 1.0);
    float3 SunDirection;
    float3 SunIlluminance;
    FindSkySun(SunDirection, SunIlluminance);
    float Mu = dot(Direction, SunDirection);
    if (Direction.y >= 0.0 && Mu > cos(0.005))
    {
        float3 Transmittance;
        SkyScattering(Direction, Transmittance);
        Radiance += Transmittance * SunIlluminance * (smoothstep(cos(0.005), cos(0.0044), Mu) * 6.0);
    }

    return max(0.0, Radiance);
}

float ShadowVisibility(Texture2D<float4> Atlas, float3 Position, float3 Normal, int ShadowIndex)
{
    if (ShadowIndex < 0 || ShadowIndex >= int(Visual.Controls.y)) return 1.0;
    FShadow Shadow = Visual.Shadows[ShadowIndex];
    int Radius = Visual.AtmosphereGeometry.w > 1.5 ? 1 : 0;
    // Cascades store their world texel size; scaling the normal offset by the PCF footprint keeps coarse cascades free of acne.
    Position += Normal * (Shadow.Parameters.z + Shadow.Parameters.w * float(Radius + 1));
    float4 Clip = mul(Shadow.WorldToClip, float4(Position, 1.0));
    float3 NDC = Clip.xyz / max(Clip.w, 0.00001);
    if (any(abs(NDC.xy) > 1.0) || NDC.z < 0.0 || NDC.z > 1.0) return 1.0;
    float2 UV = float2(NDC.x * 0.5 + 0.5, 0.5 - NDC.y * 0.5) * Shadow.Atlas.xy + Shadow.Atlas.zw;
    // (2R+1)^2 bilinear PCF taps collapse to (2R+2)^2 loads with fractional edge weights, so texel edges do not show as steps.
    uint Width, Height;
    Atlas.GetDimensions(Width, Height);
    float2 Size = float2(Width, Height);
    int Last = 2 * Radius + 1;
    float2 Texel = UV * Size - 0.5;
    float2 Fraction = frac(Texel);
    int2 Origin = int2(floor(Texel)) - Radius;
    int2 TileMin = int2(Shadow.Atlas.zw * Size + 0.5);
    int2 TileMax = TileMin + int2(Shadow.Atlas.xy * Size + 0.5) - 1;
    float Visibility = 0.0;
    for (int Y = 0; Y <= Last; ++Y)
    {
        float WeightY = Y == 0 ? 1.0 - Fraction.y : Y == Last ? Fraction.y : 1.0;
        for (int X = 0; X <= Last; ++X)
        {
            float WeightX = X == 0 ? 1.0 - Fraction.x : X == Last ? Fraction.x : 1.0;
            float Depth = Atlas.Load(int3(clamp(Origin + int2(X, Y), TileMin, TileMax), 0)).r;
            Visibility += NDC.z + Shadow.Parameters.x >= Depth ? WeightX * WeightY : 0.0;
        }
    }
    return Visibility / float(Last * Last);
}

float LightVisibility(Texture2D<float4> Atlas, FVisualLight Light, float3 Position, float3 Normal)
{
    int First = int(Light.ConeShadow.z);
    int Count = int(Light.ConeShadow.w);
    if (First < 0 || Count == 0) return 1.0;
    int Type = int(Light.PositionType.w);
    if (Type == 2 && Count == 6)
    {
        float3 D = Position - Light.PositionType.xyz;
        float3 A = abs(D);
        int Face = A.x >= A.y && A.x >= A.z ? (D.x > 0.0 ? 0 : 1) : A.y >= A.z ? (D.y > 0.0 ? 2 : 3) : (D.z > 0.0 ? 4 : 5);
        return ShadowVisibility(Atlas, Position, Normal, First + Face);
    }
    if (Type == 0)
    {
        float3 Eye = mul(Visual.ViewToWorld, float4(0.0, 0.0, 0.0, 1.0)).xyz;
        float Distance = dot(Position - Eye, normalize(mul((float3x3)Visual.ViewToWorld, float3(0.0, 0.0, 1.0))));
        for (int I = 0; I < Count; ++I)
        {
            float Split = Visual.Shadows[First + I].Parameters.y;
            if (Distance <= Split)
            {
                // Fade the last cascade out so the shadow distance does not end on a hard line.
                float Fade = I == Count - 1 ? saturate((Distance - Split * 0.85) / (Split * 0.15)) : 0.0;
                return lerp(ShadowVisibility(Atlas, Position, Normal, First + I), 1.0, Fade);
            }
        }
        return 1.0;
    }
    return ShadowVisibility(Atlas, Position, Normal, First);
}

float LightAttenuation(FVisualLight Light, float3 Position, out float3 L)
{
    int Type = int(Light.PositionType.w);
    if (Type == 0) { L = -Light.DirectionRange.xyz; return 1.0; }
    float3 Delta = Light.PositionType.xyz - Position;
    float Distance = length(Delta);
    L = Delta / max(Distance, 0.001);
    float Fade = pow(saturate(1.0 - pow(Distance / max(Light.DirectionRange.w, 0.01), 4.0)), 2.0);
    float Attenuation = Fade / max(Distance * Distance, 0.01);
    if (Type == 3 || Type == 4)
    {
        float Cone = dot(-L, Light.DirectionRange.xyz);
        Attenuation *= Type == 3 ? smoothstep(Light.ConeShadow.y, Light.ConeShadow.x, Cone) : saturate(Cone);
    }
    return Attenuation;
}

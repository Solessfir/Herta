#pragma once

struct FVisualLight
{
    float4 PositionType;
    float4 DirectionRange;
    float4 ColorIntensity;
    float4 RightWidth;
    float4 UpHeight;
    float4 ConeShadow;
};

struct FShadow
{
    column_major float4x4 WorldToClip;
    float4 Atlas;
    float4 Parameters;
};

struct FMaterial
{
    float4 BaseColor;
    float4 Surface;
    float4 Emissive;
    float4 UV;
    float4 Channels0;
    float4 Channels1;
    float4 TextureFlags;
    // The metal edge color for F82-tint Fresnel, and diffuse roughness.
    float4 Specular;
};

struct FVisualUniforms
{
    column_major float4x4 ViewToWorld;
    column_major float4x4 ClipToView;
    float4 Viewport;
    float4 Sky;
    float4 SkyColor;
    float4 Atmosphere;
    float4 AtmosphereGeometry;
    float4 Fog;
    float4 FogColor;
    float4 Controls;
    float4 SunIlluminance;
    float4 Exposure;
    float4 Display;
    float4 Occlusion;
    float4 LightGrid;
    float4 SunDirection;
    float4 SunRadiance;
    // Maps this frame's clip space to the previous frame's, for camera motion.
    column_major float4x4 ClipToPreviousClip;
    FShadow Shadows[16];
    FMaterial Material;
};

[[vk::binding(64, 0)]] ConstantBuffer<FVisualUniforms> Visual;

// Motion vectors are this frame's UV minus the previous frame's. The depth prepass leaves this where it knows no object motion, and the motion vector pass fills those pixels from depth and camera motion.
static const float2 MotionVectorUnknown = float2(65504.0, 0.0);
[[vk::binding(128, 0)]] SamplerState LinearSampler;
static const float PI = 3.14159265358979323846;

float2 DirectionUV(float3 Direction)
{
    Direction = normalize(Direction);
    return float2(frac(atan2(Direction.z, Direction.x) / (2.0 * PI) + 0.5), acos(clamp(Direction.y, -1.0, 1.0)) / PI);
}

// Keep in sync with LightClusterSlices in Visuals.h.
static const uint LightClusterSlices = 24;

float3 CameraRay(float2 UV)
{
    float4 View = mul(Visual.ClipToView, float4(UV.x * 2.0 - 1.0, 1.0 - UV.y * 2.0, 0.0001, 1.0));
    return normalize(mul((float3x3)Visual.ViewToWorld, View.xyz / View.w));
}

float3 WorldPosition(float2 UV, float Depth)
{
    float4 View = mul(Visual.ClipToView, float4(UV.x * 2.0 - 1.0, 1.0 - UV.y * 2.0, Depth, 1.0));
    return mul(Visual.ViewToWorld, float4(View.xyz / View.w, 1.0)).xyz;
}

// Keep in sync with ProceduralSky in EnvironmentLighting.cpp, which bakes the same sky for image-based lighting.
// Distances are kilometres; scale heights and the ozone layer follow the authored atmosphere height.
float3 SkyExtinction(float3 Position, float PlanetRadius, float HeightScale, out float Rayleigh, out float Mie)
{
    float Height = max(0.0, length(Position) - PlanetRadius);
    Rayleigh = exp(-Height / (8.0 * HeightScale));
    Mie = exp(-Height / (1.2 * HeightScale));
    float Ozone = max(0.0, 1.0 - abs(Height - 25.0 * HeightScale) / (15.0 * HeightScale));
    return float3(5.802e-3, 13.558e-3, 33.1e-3) * Visual.Atmosphere.x * Rayleigh + 3.996e-3 / 0.9 * Visual.Atmosphere.y * Mie + float3(0.65e-3, 1.881e-3, 0.085e-3) * Ozone;
}

float SkyExit(float3 Position, float3 Direction, float Radius)
{
    float B = dot(Position, Direction);
    float C = dot(Position, Position) - Radius * Radius;
    return -B + sqrt(max(0.0, B * B - C));
}

// The sky scatters sunlight from above the atmosphere; the light entry itself is already dimmed by the air.
void FindSkySun(out float3 Direction, out float3 Illuminance)
{
    Direction = float3(0.0, 1.0, 0.0);
    Illuminance = 128000.0;
    if (Visual.SunDirection.w > 0.5)
    {
        Direction = Visual.SunDirection.xyz;
        Illuminance = Visual.SunIlluminance.w > 0.5 ? Visual.SunIlluminance.rgb : Visual.SunRadiance.rgb;
    }
}

// Hillaire's multiple-scattering transfer from BuildSkyMultipleScattering: sun cosine across, altitude down.
float3 SkyMultipleScattering(Texture2D<float4> Table, float3 Position, float3 SunDirection, float PlanetRadius, float AtmosphereRadius)
{
    float Radius = length(Position);
    float2 UV = float2(dot(Position, SunDirection) / Radius * 0.5 + 0.5, saturate((Radius - PlanetRadius) / (AtmosphereRadius - PlanetRadius)));
    return Table.SampleLevel(LinearSampler, (UV * 31.0 + 0.5) / 32.0, 0).rgb;
}

// Rayleigh, Mie, and ozone radiance along an upper-hemisphere ray from sea level: single scattering plus the multiple-scattering table.
float3 SkyScattering(float3 View, Texture2D<float4> MultipleScatteringTable, out float3 Transmittance)
{
    float3 SunDirection;
    float3 SunIlluminance;
    FindSkySun(SunDirection, SunIlluminance);
    float PlanetRadius = Visual.AtmosphereGeometry.x / 1000.0;
    float HeightScale = Visual.AtmosphereGeometry.y / 80000.0;
    float AtmosphereRadius = PlanetRadius + Visual.AtmosphereGeometry.y / 1000.0;
    float3 Origin = float3(0.0, PlanetRadius + 0.001, 0.0);
    float Length = SkyExit(Origin, View, AtmosphereRadius);
    float Mu = dot(View, SunDirection);
    float G = Visual.Atmosphere.z;
    float RayleighPhase = 3.0 / (16.0 * PI) * (1.0 + Mu * Mu);
    float MiePhase = (1.0 - G * G) / (4.0 * PI * pow(max(1e-4, 1.0 + G * G - 2.0 * G * Mu), 1.5));
    float3 ViewDepth = 0.0;
    float3 Single = 0.0;
    float3 Multiple = 0.0;
    const int Steps = 12;
    const int SunSteps = 4;
    for (int S = 0; S < Steps; ++S)
    {
        // Quadratic spacing concentrates samples in the dense air near the viewer.
        float Start = float(S * S) / float(Steps * Steps);
        float End = float((S + 1) * (S + 1)) / float(Steps * Steps);
        float Segment = Length * (End - Start);
        float3 Position = Origin + View * (Length * (Start + End) * 0.5);
        float Rayleigh, Mie;
        float3 Extinction = SkyExtinction(Position, PlanetRadius, HeightScale, Rayleigh, Mie) * Segment;
        float3 ViewTransmittance = exp(-(ViewDepth + 0.5 * Extinction));
        ViewDepth += Extinction;
        float3 RayleighScattering = float3(5.802e-3, 13.558e-3, 33.1e-3) * Visual.Atmosphere.x * Rayleigh;
        float MieScattering = 3.996e-3 * Visual.Atmosphere.y * Mie;
        // Multiple scattering also lights air in the planet's shadow, so it is gathered before the shadow test.
        Multiple += ViewTransmittance * Segment * (RayleighScattering + MieScattering) * SkyMultipleScattering(MultipleScatteringTable, Position, SunDirection, PlanetRadius, AtmosphereRadius);
        float B = dot(Position, SunDirection);
        if (B < 0.0 && B * B - dot(Position, Position) + PlanetRadius * PlanetRadius > 0.0) continue;
        float SunLength = SkyExit(Position, SunDirection, AtmosphereRadius);
        float3 SunDepth = 0.0;
        for (int L = 0; L < SunSteps; ++L)
        {
            float SunRayleigh, SunMie;
            SunDepth += SkyExtinction(Position + SunDirection * (SunLength * (float(L) + 0.5) / float(SunSteps)), PlanetRadius, HeightScale, SunRayleigh, SunMie);
        }

        float3 Lit = ViewTransmittance * exp(-SunDepth * (SunLength / float(SunSteps))) * Segment;
        Single += Lit * (RayleighScattering * RayleighPhase + MieScattering * MiePhase);
    }

    Transmittance = exp(-ViewDepth);
    return (Single + Multiple) * SunIlluminance;
}

// Optical depth from sea level along an upper-hemisphere ray, for the sun disc seen through the air.
float3 SkyTransmittance(float3 View)
{
    float PlanetRadius = Visual.AtmosphereGeometry.x / 1000.0;
    float HeightScale = Visual.AtmosphereGeometry.y / 80000.0;
    float3 Origin = float3(0.0, PlanetRadius + 0.001, 0.0);
    float Length = SkyExit(Origin, View, PlanetRadius + Visual.AtmosphereGeometry.y / 1000.0);
    float3 Depth = 0.0;
    const int Steps = 12;
    for (int S = 0; S < Steps; ++S)
    {
        float Start = float(S * S) / float(Steps * Steps);
        float End = float((S + 1) * (S + 1)) / float(Steps * Steps);
        float Rayleigh, Mie;
        Depth += SkyExtinction(Origin + View * (Length * (Start + End) * 0.5), PlanetRadius, HeightScale, Rayleigh, Mie) * (Length * (End - Start));
    }

    return exp(-Depth);
}

// The sky-view table covers the upper hemisphere; latitude is square-root mapped so the horizon band gets most rows.
float2 SkyViewUV(float3 View)
{
    return float2(atan2(View.z, View.x) / (2.0 * PI) + 0.5, sqrt(saturate(asin(saturate(View.y)) / (0.5 * PI))));
}

float3 SkyViewDirection(float2 UV)
{
    float Latitude = UV.y * UV.y * 0.5 * PI;
    float Azimuth = (UV.x - 0.5) * 2.0 * PI;
    return float3(cos(Latitude) * cos(Azimuth), sin(Latitude), cos(Latitude) * sin(Azimuth));
}

// Below the horizon, Scattering holds the horizon colour for that direction; it darkens towards the nadir, reading as distant haze rather than a flat ground plane.
float3 ComposeProceduralSky(float3 Direction, float3 Scattering)
{
    float3 Radiance = Scattering * (Direction.y < 0.0 ? 1.0 - 0.7 * sqrt(saturate(-Direction.y)) : 1.0);
    float3 SunDirection;
    float3 SunIlluminance;
    FindSkySun(SunDirection, SunIlluminance);
    float Mu = dot(Direction, SunDirection);
    if (Direction.y >= 0.0 && Mu > cos(0.005))
    {
        // The disc's luminance is the sun's illuminance spread over its 0.27 degree angular radius, about 7e-5 sr.
        const float SunSolidAngle = 2.0 * PI * (1.0 - cos(0.0047));
        Radiance += SkyTransmittance(Direction) * SunIlluminance * (smoothstep(cos(0.005), cos(0.0044), Mu) / SunSolidAngle);
    }

    return max(0.0, Radiance);
}

// Automatic exposure meters a grid of log luminance and histograms it over EV -10 to 16 in 64 bins.
static const int ExposureMeteringSize = 32;
static const int ExposureHistogramBinCount = 64;
static const float ExposureMinimumLog = -10.0;
static const float ExposureMaximumLog = 16.0;

int ExposureHistogramBin(float LogLuminance)
{
    return clamp(int((LogLuminance - ExposureMinimumLog) / (ExposureMaximumLog - ExposureMinimumLog) * ExposureHistogramBinCount), 0, ExposureHistogramBinCount - 1);
}

// The tone mapping LUT unwraps 64 log2 exposure steps per channel into 64 slices of 64x64 side by side, blue choosing the slice.
// GT7's hue-preserving highlight fade bends sharply, and 32 steps put saturated highlights 20+ sRGB levels off where 64 stay within a few.
// 2^-12 is black on any display, and 2^8 of exposed paper white is past every display peak.
static const float ToneMapLutSize = 64.0;
static const float ToneMapLutMinimumLog2 = -12.0;
static const float ToneMapLutMaximumLog2 = 8.0;

float3 ToneMapLutDecode(float3 Index)
{
    return exp2(lerp(ToneMapLutMinimumLog2, ToneMapLutMaximumLog2, Index));
}

// Each cascade is fitted to its own slice of the view, so a point near a split may fall outside the next one.
bool ShadowCovers(int ShadowIndex, float3 Position)
{
    float4 Clip = mul(Visual.Shadows[ShadowIndex].WorldToClip, float4(Position, 1.0));
    float3 NDC = Clip.xyz / max(Clip.w, 0.00001);
    return all(abs(NDC.xy) <= 0.98) && NDC.z >= 0.0 && NDC.z <= 1.0;
}

// Sixteen points spread evenly over the unit disc on a Vogel spiral. The pattern is fixed, because a per-pixel rotation would leave grain that only temporal accumulation removes.
static const float2 PenumbraTaps[16] = {
    float2(0.1768, 0.0000),
    float2(-0.2258, 0.2068),
    float2(0.0346, -0.3938),
    float2(0.2846, 0.3712),
    float2(-0.5222, -0.0924),
    float2(0.4947, -0.3147),
    float2(-0.1655, 0.6155),
    float2(-0.3156, -0.6076),
    float2(0.6846, 0.2500),
    float2(-0.7123, 0.2940),
    float2(0.3434, -0.7337),
    float2(0.2537, 0.8089),
    float2(-0.7647, -0.4432),
    float2(0.8971, -0.1972),
    float2(-0.5475, 0.7788),
    float2(-0.1265, -0.9761),
};

// Texels searched for occluders around a sun shadow lookup, and the widest penumbra filter, both in shadow texels. Wider penumbrae are clamped so the cost stays bounded.
// Widest penumbra filter in shadow texels. Sixteen bilinear taps stay smooth up to about this radius; wider penumbrae are clamped, keeping the cost bounded.
static const float PenumbraMaximumTexels = 4.0;
// The occluder search reaches past the widest filter, so a pixel at the outer edge of a wide penumbra still finds what darkens it.
static const float PenumbraSearchTexels = 3.0;

// Bilinear PCF at one point: a gather of the 2x2 texels around it, weighted by the point's position between them.
// DepthSlope extends the receiver's plane to the point, so a wide footprint on a slope does not compare against the receiver's own surface.
float BilinearShadow(Texture2D<float4> Atlas, float2 Texel, float2 Offset, float Reference, float2 DepthSlope, float2 Size, int2 TileMin, int2 TileMax)
{
    float2 Point = Texel + Offset;
    float2 F = frac(Point);
    float2 Corner = float2(clamp(int2(floor(Point)) + 1, TileMin + 1, TileMax));
    float4 Lit = step(Atlas.GatherRed(LinearSampler, Corner / Size), Reference + dot(DepthSlope, Offset));
    return dot(Lit, float4((1.0 - F.x) * F.y, F.x * F.y, F.x * (1.0 - F.y), (1.0 - F.x) * (1.0 - F.y)));
}

// The receiver's depth change per shadow texel, from its normal in light space: an orthographic projection keeps a plane a plane.
// Computing it from the normal instead of screen derivatives keeps it valid inside light loops. Near-grazing slopes are clamped to ten metres per metre.
float2 ReceiverDepthSlope(FShadow Shadow, float3 Normal, float2 TileTexels)
{
    float3 Rows[3] = {Shadow.WorldToClip[0].xyz, Shadow.WorldToClip[1].xyz, Shadow.WorldToClip[2].xyz};
    float3 Gradient = float3(dot(Rows[0], Normal) / dot(Rows[0], Rows[0]), dot(Rows[1], Normal) / dot(Rows[1], Rows[1]), dot(Rows[2], Normal) / dot(Rows[2], Rows[2]));
    // Texel x follows NDC x; texel y runs against NDC y.
    float2 Slope = float2(-Gradient.x, Gradient.y) / max(abs(Gradient.z), 1e-6) * sign(Gradient.z) * 2.0 / TileTexels;
    float Limit = 10.0 * Shadow.Parameters.w * length(Rows[2]);
    return clamp(Slope, -Limit, Limit);
}

// PenumbraSlope is how much a directional light's penumbra widens per metre between occluder and receiver. With soft shadows it sizes the filter
// from the average occluder distance (percentage-closer soft shadows), so shadows are crisp at contact and soften with distance.
float ShadowVisibility(Texture2D<float4> Atlas, float3 Position, float3 Normal, int ShadowIndex, bool bAllowSoft, float PenumbraSlope = 0.0)
{
    if (ShadowIndex < 0 || ShadowIndex >= int(Visual.Controls.y)) return 1.0;
    FShadow Shadow = Visual.Shadows[ShadowIndex];
    int Radius = bAllowSoft && Visual.AtmosphereGeometry.w > 1.5 ? 1 : 0;
    // Cascades store their world texel size; scaling the normal offset by the PCF footprint keeps coarse cascades free of acne.
    Position += Normal * (Shadow.Parameters.z + Shadow.Parameters.w * float(Radius + 1));
    float4 Clip = mul(Shadow.WorldToClip, float4(Position, 1.0));
    float3 NDC = Clip.xyz / max(Clip.w, 0.00001);
    if (any(abs(NDC.xy) > 1.0) || NDC.z < 0.0 || NDC.z > 1.0) return 1.0;
    float2 UV = float2(NDC.x * 0.5 + 0.5, 0.5 - NDC.y * 0.5) * Shadow.Atlas.xy + Shadow.Atlas.zw;
    // (2R+1)^2 bilinear PCF taps collapse to (2R+2)^2 loads with fractional edge weights, so texel edges do not show as steps.
    uint Width, Height;
    Atlas.GetDimensions(Width, Height);
    float2 Size = float2(Width, Height);
    int Last = 2 * Radius + 1;
    float2 Texel = UV * Size - 0.5;
    float2 Fraction = frac(Texel);
    int2 Origin = int2(floor(Texel)) - Radius;
    int2 TileMin = int2(Shadow.Atlas.zw * Size + 0.5);
    int2 TileMax = TileMin + int2(Shadow.Atlas.xy * Size + 0.5) - 1;
    float Reference = NDC.z + Shadow.Parameters.x;
    [branch]
    if (Radius > 0 && PenumbraSlope > 0.0 && Shadow.Parameters.w > 0.0)
    {
        float2 DepthSlope = ReceiverDepthSlope(Shadow, Normal, Shadow.Atlas.xy * Size);
        // A gather at the centre and one past each corner of the widest filter find the occluders. Reversed depth puts an occluder above the receiver.
        float BlockerSum = 0.0;
        float BlockerCount = 0.0;
        for (int Search = 0; Search < 5; ++Search)
        {
            float2 Offset = Search == 0 ? float2(0.0, 0.0) : float2((Search & 1) != 0 ? 1.0 : -1.0, (Search & 2) != 0 ? 1.0 : -1.0) * PenumbraSearchTexels;
            float2 Sample = float2(clamp(int2(floor(Texel + Offset)) + 1, TileMin + 1, TileMax));
            float4 Depths = Atlas.GatherRed(LinearSampler, Sample / Size);
            float4 Blocks = 1.0 - step(Depths, Reference + dot(DepthSlope, Offset));
            BlockerSum += dot(Blocks, Depths);
            BlockerCount += dot(Blocks, 1.0);
        }

        if (BlockerCount == 0.0)
        {
            return 1.0;
        }

        // Orthographic depth is linear, and the depth row of the cascade's matrix holds its NDC change per metre.
        float Distance = max(0.0, BlockerSum / BlockerCount - Reference) / length(Shadow.WorldToClip[2].xyz);
        float FilterTexels = clamp(0.5 * PenumbraSlope * Distance / Shadow.Parameters.w, 1.0, PenumbraMaximumTexels);
        // Every sample occluded around a filter no wider than the search means the whole footprint is in shadow.
        if (BlockerCount == 20.0 && FilterTexels <= PenumbraSearchTexels)
        {
            return 0.0;
        }

        float Soft = 0.0;
        for (int Tap = 0; Tap < 16; ++Tap)
        {
            Soft += BilinearShadow(Atlas, Texel, PenumbraTaps[Tap] * FilterTexels, Reference, DepthSlope, Size, TileMin, TileMax);
        }

        return Soft / 16.0;
    }

    float Visibility = 0.0;
    // Each gather returns a 2x2 block, a quarter of the loads. Its corner stays inside the tile so it never reads a neighbouring one.
    for (int Y = 0; Y <= Last; Y += 2)
    {
        float2 WeightY = float2(Y == 0 ? 1.0 - Fraction.y : 1.0, Y + 1 == Last ? Fraction.y : 1.0);
        for (int X = 0; X <= Last; X += 2)
        {
            float2 WeightX = float2(X == 0 ? 1.0 - Fraction.x : 1.0, X + 1 == Last ? Fraction.x : 1.0);
            float2 Corner = float2(clamp(Origin + int2(X + 1, Y + 1), TileMin + 1, TileMax));
            float4 Lit = step(Atlas.GatherRed(LinearSampler, Corner / Size), Reference);
            Visibility += dot(Lit, float4(WeightX.x * WeightY.y, WeightX.y * WeightY.y, WeightX.y * WeightY.x, WeightX.x * WeightY.x));
        }
    }
    return Visibility / float(Last * Last);
}

// Volumetric fog passes bAllowSoft false: its dither and upsample blur already soften shadows, and soft filtering costs four times the loads at every ray step.
// Directional cascades live in the 16-bit cascade atlas and local lights in the 32-bit local one.
float LightVisibility(Texture2D<float4> CascadeAtlas, Texture2D<float4> LocalAtlas, FVisualLight Light, float3 Position, float3 Normal, bool bAllowSoft = true)
{
    int First = int(Light.ConeShadow.z);
    int Count = int(Light.ConeShadow.w);
    if (First < 0 || Count == 0) return 1.0;
    int Type = int(Light.PositionType.w);
    if (Type == 2 && Count == 6)
    {
        float3 D = Position - Light.PositionType.xyz;
        float3 A = abs(D);
        int Face = A.x >= A.y && A.x >= A.z ? (D.x > 0.0 ? 0 : 1) : A.y >= A.z ? (D.y > 0.0 ? 2 : 3) : (D.z > 0.0 ? 4 : 5);
        return ShadowVisibility(LocalAtlas, Position, Normal, First + Face, bAllowSoft);
    }
    if (Type == 0)
    {
        float3 Eye = mul(Visual.ViewToWorld, float4(0.0, 0.0, 0.0, 1.0)).xyz;
        float Distance = dot(Position - Eye, normalize(mul((float3x3)Visual.ViewToWorld, float3(0.0, 0.0, 1.0))));
        // Shadows fade out over the last 15% of the light's range, so the shadow distance does not end on a hard line.
        float Range = Light.DirectionRange.w;
        float Fade = saturate((Distance - Range * 0.85) / (Range * 0.15));
        for (int I = 0; I < Count; ++I)
        {
            float Split = Visual.Shadows[First + I].Parameters.y;
            bool bLast = I == Count - 1;
            // Cascades fit the depth seen a few frames ago, so the last one also serves anything it covers beyond its split until they catch up.
            if (Distance <= Split || (bLast && ShadowCovers(First + I, Position)))
            {
                float Visibility = ShadowVisibility(CascadeAtlas, Position, Normal, First + I, bAllowSoft, Light.ConeShadow.x);
                // The last tenth of each cascade blends into the next one, whose texels are about three times larger, so the switch does not show as a line.
                float Blend = saturate((Distance - Split * 0.9) / (Split * 0.1));
                [branch]
                if (!bLast && Blend > 0.0 && ShadowCovers(First + I + 1, Position))
                {
                    Visibility = lerp(Visibility, ShadowVisibility(CascadeAtlas, Position, Normal, First + I + 1, bAllowSoft, Light.ConeShadow.x), Blend);
                }

                return lerp(Visibility, 1.0, Fade);
            }
        }
        return 1.0;
    }
    return ShadowVisibility(LocalAtlas, Position, Normal, First, bAllowSoft);
}

float LightAttenuation(FVisualLight Light, float3 Position, out float3 L)
{
    int Type = int(Light.PositionType.w);
    if (Type == 0) { L = -Light.DirectionRange.xyz; return 1.0; }
    float3 Delta = Light.PositionType.xyz - Position;
    float Distance = length(Delta);
    L = Delta / max(Distance, 0.001);
    float Fade = pow(saturate(1.0 - pow(Distance / max(Light.DirectionRange.w, 0.01), 4.0)), 2.0);
    float Attenuation = Fade / max(Distance * Distance, 0.01);
    if (Type == 3 || Type == 4)
    {
        float Cone = dot(-L, Light.DirectionRange.xyz);
        Attenuation *= Type == 3 ? smoothstep(Light.ConeShadow.y, Light.ConeShadow.x, Cone) : saturate(Cone);
    }
    return Attenuation;
}

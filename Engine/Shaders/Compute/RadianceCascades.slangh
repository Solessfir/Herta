#pragma once
#include "../VisualShared.slangh"

// Split Radiance Cascades (Freeman and Sannikov 2026): sparse world-space probes near visible surfaces, one hashmap per cascade,
// filled by rays from on-screen surfaces that deposit into every cascade interval they cross. Keep the constants in sync with RadianceCascades.cpp.
static const uint CascadeCount = 3;
// Cascade n probes are spaced 2^n times cascade 0's, see 4^n times as many directions, and cover intervals 4^n times as long.
static const uint BaseDirectionRows = 4;
// Cascade 0's spacing is this fraction of the distance at which its level of detail starts, so probes keep a similar size on screen.
static const float SpacingRatio = 1.0 / 48.0;
// Level of detail L covers Chebyshev distances from 2^L to 2^(L+1) metres, and level 0 everything nearer.
static const float LevelDistance = 1.0;
static const uint LevelCount = 16;
static const float BaseInterval = 1.6;
// Columns, arches, and other thin geometry keep higher cascades fuller than the 4:1 a flat surface gives: Sponza's nave fills 38,082, 12,063, and
// 3,682 probes, so the higher cascades get twice a flat surface's share. Overflow would drop different probes every frame.
static const uint ProbeCapacity[CascadeCount] = { 65536u, 32768u, 8192u };
static const uint ProbeBase[CascadeCount] = { 0u, 65536u, 98304u };
static const uint SlotCapacity[CascadeCount] = { 131072u, 65536u, 16384u };
static const uint SlotBase[CascadeCount] = { 0u, 131072u, 196608u };
static const uint RecordBase[CascadeCount] = { 0u, 2097152u, 6291456u };
static const uint RecordTotal = 10485760u;
// Octahedral irradiance tiles: 6x6 texels inside a one-texel border, 256 tiles to a row of the atlas.
static const uint IrradianceTexels = 6;
static const uint IrradianceTile = 8;
static const uint IrradianceTilesPerRow = 256;
static const uint MissingProbe = 0xFFFFFFFFu;

// Counters: probes allocated per cascade, then probes that did not fit.
static const uint CounterProbes = 0;
static const uint CounterOverflow = 5;

// Each hash slot holds its key and its probe index.
[[vk::binding(GiBufferBase + 0, 0)]] RWStructuredBuffer<uint> Slots;
// Each probe holds its key, its hash slot, and the index of the probe it nests in one cascade up.
[[vk::binding(GiBufferBase + 1, 0)]] RWStructuredBuffer<uint> Probes;
[[vk::binding(GiBufferBase + 2, 0)]] RWStructuredBuffer<uint> Counters;
// Deposited radiance, three floats per direction record.
[[vk::binding(GiBufferBase + 3, 0)]] RWStructuredBuffer<float> Deposits;
// Rays deposited per record in the low 16 bits, and those that passed the interval unoccluded in the high 16.
[[vk::binding(GiBufferBase + 4, 0)]] RWStructuredBuffer<uint> RecordCounts;
// Merged radiance, one RGB9E5 word per record: cascade 0's per direction, higher cascades' already averaged into the next lower cascade's directions.
[[vk::binding(GiBufferBase + 5, 0)]] RWStructuredBuffer<uint> Merged;
// The hit cache's slots: a key and the frame it was last read, two words each. Its sums and averages follow the history counts in Deposits.
[[vk::binding(GiBufferBase + 6, 0)]] RWStructuredBuffer<uint> CacheKeys;

uint DirectionRows(uint Cascade)
{
    return BaseDirectionRows << Cascade;
}

uint DirectionCount(uint Cascade)
{
    return 2u * DirectionRows(Cascade) * DirectionRows(Cascade);
}

int3 FloorShift(int3 Cell, uint Shift)
{
    return Cell >> int(Shift);
}

float3 CameraPosition()
{
    return mul(Visual.ViewToWorld, float4(0.0, 0.0, 0.0, 1.0)).xyz;
}

uint LevelOfDetailFrom(float3 Eye, float3 Position)
{
    float3 Delta = abs(Position - Eye);
    float Distance = max(Delta.x, max(Delta.y, Delta.z));
    return min(uint(max(0.0, floor(log2(max(Distance, 1e-4) / LevelDistance)))), LevelCount - 1);
}

uint LevelOfDetail(float3 Position)
{
    return LevelOfDetailFrom(CameraPosition(), Position);
}

// Each level reaches 1/0.9 of the way into the next one's range, and surfaces in that overlap blend the two, so probes do not pop to the coarser size
// as the camera moves away. Returns the weight of Level; the finer level, one below, takes the rest.
static const float LevelOverlap = 1.0 / 0.9;

float LevelBlend(float3 Position, uint Level)
{
    if (Level == 0u)
        return 1.0;

    float3 Delta = abs(Position - CameraPosition());
    float Distance = max(Delta.x, max(Delta.y, Delta.z));
    return saturate((Distance / (LevelDistance * float(1u << Level)) - 1.0) / (LevelOverlap - 1.0));
}

float BaseSpacing(uint Level)
{
    return LevelDistance * float(1u << Level) * SpacingRatio;
}

// Cells are world-space; keys store them relative to the camera's cell, snapped so every cascade's cells nest.
int3 CameraCellFrom(float3 Eye, uint Level)
{
    return int3(floor(Eye / BaseSpacing(Level))) & ~int(7);
}

int3 CameraCell(uint Level)
{
    return CameraCellFrom(CameraPosition(), Level);
}

// Bit 31 marks a used slot, bits 27-30 hold the level, and three 9-bit fields the cascade cell relative to the camera's.
uint MakeKeyFrom(int3 Camera, uint Level, uint Cascade, int3 Cell)
{
    int3 Relative = Cell - FloorShift(Camera, Cascade);
    if (any(Relative < -256) || any(Relative > 255))
        return 0u;

    uint3 Bits = uint3(Relative) & 511u;
    return 0x80000000u | (Level << 27) | (Bits.x << 18) | (Bits.y << 9) | Bits.z;
}

uint MakeKey(uint Level, uint Cascade, int3 Cell)
{
    return MakeKeyFrom(CameraCell(Level), Level, Cascade, Cell);
}

uint KeyLevel(uint Key)
{
    return (Key >> 27) & 15u;
}

int3 KeyCell(uint Key, uint Cascade)
{
    int3 Relative = int3((Key >> 18) & 511u, (Key >> 9) & 511u, Key & 511u);
    Relative = (Relative ^ 256) - 256;
    return Relative + FloorShift(CameraCell(KeyLevel(Key)), Cascade);
}

float3 ProbePosition(uint Key, uint Cascade)
{
    return (float3(KeyCell(Key, Cascade)) + 0.5) * (BaseSpacing(KeyLevel(Key)) * float(1u << Cascade));
}

uint HashKey(uint Key)
{
    uint State = Key * 747796405u + 2891336453u;
    uint Word = ((State >> ((State >> 28u) + 4u)) ^ State) * 277803737u;
    return (Word >> 22u) ^ Word;
}

static const uint ProbeSteps = 32;

// The slot holding Key, inserting it if absent; MissingProbe when the table is full.
uint InsertKey(uint Cascade, uint Key)
{
    uint Mask = SlotCapacity[Cascade] - 1u;
    uint Slot = HashKey(Key) & Mask;
    for (uint Step = 0; Step < ProbeSteps; ++Step)
    {
        uint Index = (SlotBase[Cascade] + Slot) * 2u;
        uint Existing = Slots[Index];
        if (Existing == 0u)
            InterlockedCompareExchange(Slots[Index], 0u, Key, Existing);
        if (Existing == 0u || Existing == Key)
            return Slot;
        Slot = (Slot + 1u) & Mask;
    }

    return MissingProbe;
}

// Last frame's cascade 0 probe at Level and Cell, found in last frame's hash slots, whose keys were relative to Eye.
uint FindPreviousProbe(StructuredBuffer<uint> PreviousSlots, float3 Eye, uint Level, int3 Cell)
{
    uint Key = MakeKeyFrom(CameraCellFrom(Eye, Level), Level, 0, Cell);
    if (Key == 0u)
        return MissingProbe;

    uint Mask = SlotCapacity[0] - 1u;
    uint Slot = HashKey(Key) & Mask;
    for (uint Step = 0; Step < ProbeSteps; ++Step)
    {
        uint Existing = PreviousSlots[(SlotBase[0] + Slot) * 2u];
        if (Existing == Key)
            return PreviousSlots[(SlotBase[0] + Slot) * 2u + 1u];
        if (Existing == 0u)
            return MissingProbe;
        Slot = (Slot + 1u) & Mask;
    }

    return MissingProbe;
}

uint FindSlot(uint Cascade, uint Key)
{
    if (Key == 0u)
        return MissingProbe;

    uint Mask = SlotCapacity[Cascade] - 1u;
    uint Slot = HashKey(Key) & Mask;
    for (uint Step = 0; Step < ProbeSteps; ++Step)
    {
        uint Existing = Slots[(SlotBase[Cascade] + Slot) * 2u];
        if (Existing == Key)
            return Slot;
        if (Existing == 0u)
            return MissingProbe;
        Slot = (Slot + 1u) & Mask;
    }

    return MissingProbe;
}

// The probe index of a slot, or MissingProbe when its probe did not fit.
uint SlotProbe(uint Cascade, uint Slot)
{
    return Slot == MissingProbe ? MissingProbe : Slots[(SlotBase[Cascade] + Slot) * 2u + 1u];
}

uint FindProbe(uint Cascade, uint Key)
{
    return SlotProbe(Cascade, FindSlot(Cascade, Key));
}

uint RecordIndex(uint Cascade, uint Probe, uint Direction)
{
    return RecordBase[Cascade] + Probe * DirectionCount(Cascade) + Direction;
}

// Equal-area mapping around world up, as in the paper's Algorithm 2.
float2 EncodeDirection(float3 Direction)
{
    return float2(frac(atan2(Direction.z, Direction.x) / (2.0 * PI)), saturate(Direction.y * 0.5 + 0.5));
}

float3 DecodeDirection(float2 UV)
{
    float Phi = UV.x * 2.0 * PI;
    float Y = UV.y * 2.0 - 1.0;
    float R = sqrt(saturate(1.0 - Y * Y));
    return float3(R * cos(Phi), Y, R * sin(Phi));
}

// Directions are numbered so the four that average into one direction of the cascade below are adjacent: a quadtree over the 2:1 grid of cascade 0.
uint DirectionIndex(uint Cascade, float2 UV)
{
    uint Rows = DirectionRows(Cascade);
    uint2 Cell = min(uint2(UV * float2(2u * Rows, Rows)), uint2(2u * Rows - 1u, Rows - 1u));
    uint Index = (Cell.y >> Cascade) * (2u * BaseDirectionRows) + (Cell.x >> Cascade);
    for (uint Level = Cascade; Level > 0; --Level)
    {
        uint Shift = Level - 1u;
        Index = Index * 4u + ((Cell.x >> Shift) & 1u) + 2u * ((Cell.y >> Shift) & 1u);
    }

    return Index;
}

float2 DirectionCenter(uint Cascade, uint Index)
{
    uint2 Cell = 0u;
    for (uint Level = 0; Level < Cascade; ++Level)
    {
        uint Child = Index & 3u;
        Cell |= uint2(Child & 1u, Child >> 1) << Level;
        Index >>= 2;
    }

    Cell += uint2(Index % (2u * BaseDirectionRows), Index / (2u * BaseDirectionRows)) << Cascade;
    uint Rows = DirectionRows(Cascade);
    return (float2(Cell) + 0.5) / float2(2u * Rows, Rows);
}

// The far end of each cascade's interval; the last cascade reaches infinity.
float IntervalEnd(uint Level, uint Cascade)
{
    return Cascade + 1u == CascadeCount ? 1e30 : BaseInterval * BaseSpacing(Level) * float(1u << (2u * Cascade));
}

float4 UnpackHalf4(uint2 Words)
{
    return float4(f16tof32(Words.x), f16tof32(Words.x >> 16), f16tof32(Words.y), f16tof32(Words.y >> 16));
}

uint2 PackHalf4(float4 Value)
{
    uint4 Bits = f32tof16(min(Value, 65504.0));
    return uint2(Bits.x | (Bits.y << 16), Bits.z | (Bits.w << 16));
}

// The irradiance atlas and the output are stored at this scale: sunlit irradiance passes 100,000, beyond half precision.
// The mesh pass multiplies the output back.
static const float StoredScale = 1.0 / 16.0;

// Merged radiance is RGB9E5, one word per direction: merging reads eight neighbours per direction, so the word it saves halves its loads.
// Nine mantissa bits under a shared exponent keep 0.2% precision for the brightest channel and reach past 65,000.
// Directions no ray told anything about. Guessing open sky there floods enclosed spaces with light, and guessing black darkens them, so they stay
// unknown: interpolation and averaging skip them, and irradiance integrates only what is known. Clamping below 65408 keeps real values off this word.
static const uint UnknownRadiance = 0xFFFFFFFFu;

// After the deposits, two alternating arrays hold how many frames each cascade 0 probe's irradiance has averaged.
static const uint HistoryBase = RecordTotal * 3u;

// Rays whose hits last frame's probes did not cover, such as surfaces off screen, read their bounce light from a world-space hash of irradiance
// at hits instead. Cells are four cascade 0 probes wide and split by the normal's dominant axis, so a slab's two faces stay apart. Each cell keeps
// eight floats after the history counts: this frame's irradiance sum and sample count, then its running average and how many frames that holds.
static const uint CacheCapacity = 131072u;
static const uint CacheBase = HistoryBase + 65536u * 2u;
static const uint CacheFloats = 8u;
// Cells unread this many frames are freed.
static const uint CacheLifetime = 120u;
// Each frame adds up to CacheSamples rays per cell, and its average keeps about 20 frames of them.
static const float CacheSamples = 4.0;
static const float CacheBlend = 0.05;

uint MeanBin(float3 Direction)
{
    float3 Size = abs(Direction);
    if (Size.x >= Size.y && Size.x >= Size.z)
        return Direction.x < 0.0 ? 1u : 0u;
    if (Size.y >= Size.z)
        return Direction.y < 0.0 ? 3u : 2u;
    return Direction.z < 0.0 ? 5u : 4u;
}

uint StoreRadiance(float3 Radiance)
{
    float3 Clamped = clamp(Radiance, 0.0, 65000.0);
    float Largest = max(Clamped.r, max(Clamped.g, Clamped.b));
    int Exponent = max(-16, int(floor(log2(max(Largest, 1e-30))))) + 1;
    float Scale = exp2(float(9 - Exponent));
    if (uint(floor(Largest * Scale + 0.5)) == 512u)
    {
        Exponent += 1;
        Scale *= 0.5;
    }

    uint3 Mantissa = min(uint3(floor(Clamped * Scale + 0.5)), 511u);
    return Mantissa.r | (Mantissa.g << 9) | (Mantissa.b << 18) | (uint(Exponent + 15) << 27);
}

float3 LoadRadiance(uint Word)
{
    return float3(Word & 511u, (Word >> 9) & 511u, (Word >> 18) & 511u) * exp2(float(int(Word >> 27) - 15 - 9));
}

// The world position and depth-derived normal under a pixel, or false for the sky.
bool SurfaceAt(Texture2D<float> Depth, int2 Pixel, out float3 Position, out float3 Normal)
{
    int2 Size = int2(Visual.Viewport.zw);
    float D = Depth.Load(int3(Pixel, 0));
    Position = 0.0;
    Normal = 0.0;
    if (D <= 0.0)
        return false;

    float2 UV = (float2(Pixel) + 0.5) * Visual.Viewport.xy;
    Position = WorldPosition(UV, D);
    // The neighbour on each axis with the closer depth gives the tangent least likely to span an edge.
    int2 Left = max(Pixel - int2(1, 0), 0);
    int2 Right = min(Pixel + int2(1, 0), Size - 1);
    int2 Up = max(Pixel - int2(0, 1), 0);
    int2 Down = min(Pixel + int2(0, 1), Size - 1);
    float DL = Depth.Load(int3(Left, 0));
    float DR = Depth.Load(int3(Right, 0));
    float DU = Depth.Load(int3(Up, 0));
    float DD = Depth.Load(int3(Down, 0));
    float3 X = abs(DR - D) < abs(DL - D) ? WorldPosition((float2(Right) + 0.5) * Visual.Viewport.xy, DR) - Position : Position - WorldPosition((float2(Left) + 0.5) * Visual.Viewport.xy, DL);
    float3 Y = abs(DD - D) < abs(DU - D) ? WorldPosition((float2(Down) + 0.5) * Visual.Viewport.xy, DD) - Position : Position - WorldPosition((float2(Up) + 0.5) * Visual.Viewport.xy, DU);
    Normal = cross(Y, X);
    float Length = length(Normal);
    if (Length <= 0.0)
        return false;

    Normal /= Length;
    float3 Eye = mul(Visual.ViewToWorld, float4(0.0, 0.0, 0.0, 1.0)).xyz;
    if (dot(Normal, Eye - Position) < 0.0)
        Normal = -Normal;
    return true;
}

// Octahedral encoding of the irradiance tiles (Engelhardt and Dachsbacher 2008).
float2 OctahedralEncode(float3 N)
{
    N /= abs(N.x) + abs(N.y) + abs(N.z);
    float2 Result = N.y >= 0.0 ? N.xz : (1.0 - abs(N.zx)) * float2(N.x >= 0.0 ? 1.0 : -1.0, N.z >= 0.0 ? 1.0 : -1.0);
    return Result * 0.5 + 0.5;
}

float3 OctahedralDecode(float2 UV)
{
    float2 F = UV * 2.0 - 1.0;
    float3 N = float3(F.x, 1.0 - abs(F.x) - abs(F.y), F.y);
    float T = saturate(-N.y);
    N.x += N.x >= 0.0 ? -T : T;
    N.z += N.z >= 0.0 ? -T : T;
    return normalize(N);
}

uint2 IrradianceTileOrigin(uint Probe)
{
    return uint2(Probe % IrradianceTilesPerRow, Probe / IrradianceTilesPerRow) * IrradianceTile;
}

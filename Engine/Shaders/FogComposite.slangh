#pragma once
#include "VisualShared.slangh"

// A 3x3 Gaussian over the low-resolution volume both upsamples it and averages the per-pixel ray-march dither; depth similarity keeps fog from bleeding across silhouettes.
float4 UpsampleFog(Texture2D<float4> FogVolume, Texture2D<float4> DepthTexture, float2 ScreenUV, int2 Pixel)
{
    float Depth = DepthTexture.Load(int3(Pixel, 0)).r;
    uint W, H;
    FogVolume.GetDimensions(W, H);
    float2 Size = float2(W, H);
    float2 Texel = ScreenUV * Size - 0.5;
    float2 Center = round(Texel);
    // The Gaussian is separable, so three weights per axis replace nine exponentials.
    float3 OffsetX = Center.x + float3(-1.0, 0.0, 1.0) - Texel.x;
    float3 OffsetY = Center.y + float3(-1.0, 0.0, 1.0) - Texel.y;
    float3 WeightX = exp(-0.5 * OffsetX * OffsetX);
    float3 WeightY = exp(-0.5 * OffsetY * OffsetY);
    float DepthFalloff = -1.0 / max(0.0001, Depth * 0.1);
    float4 Fog = 0.0;
    float Total = 0.0;
    for (int Y = 0; Y < 3; ++Y)
    for (int X = 0; X < 3; ++X)
    {
        float2 UV = (Center + float2(X - 1, Y - 1) + 0.5) / Size;
        float OtherDepth = DepthTexture.Load(int3(UV * Visual.Viewport.zw, 0)).r;
        float Weight = WeightX[X] * WeightY[Y] * exp(abs(Depth - OtherDepth) * DepthFalloff);
        Fog += FogVolume.SampleLevel(LinearSampler, UV, 0) * Weight;
        Total += Weight;
    }

    return Total > 0.00001 ? Fog / Total : FogVolume.SampleLevel(LinearSampler, ScreenUV, 0);
}

#pragma once
#include "VisualShared.slangh"

// Upsamples the denoised fog with bilinear weights scaled by depth similarity, so fog does not bleed across silhouettes.
// One gather reads the four texels' depths, keeping the full-resolution pass to few texture fetches.
float4 UpsampleFog(Texture2D<float4> FogVolume, Texture2D<float> FogDepth, float2 ScreenUV, float Depth)
{
    uint Width, Height;
    FogVolume.GetDimensions(Width, Height);
    float2 Size = float2(Width, Height);
    float2 Texel = ScreenUV * Size - 0.5;
    float2 Base = floor(Texel);
    float2 F = Texel - Base;
    // Gather order: (0, 1), (1, 1), (1, 0), (0, 0) from Base.
    float4 Depths = FogDepth.Gather(LinearSampler, (Base + 1.0) / Size);
    float4 Bilinear = float4((1.0 - F.x) * F.y, F.x * F.y, F.x * (1.0 - F.y), (1.0 - F.x) * (1.0 - F.y));
    float4 Difference = abs(Depth - Depths);
    float4 Weights = Bilinear * exp(Difference * (-1.0 / max(0.0001, Depth * 0.1)));
    float Total = dot(Weights, 1.0);
    // A pixel unlike all four texels, such as a thin object over the sky, takes the closest one.
    if (Total < 1e-5)
    {
        float Closest = min(min(Difference.x, Difference.y), min(Difference.z, Difference.w));
        Weights = float4(Difference == Closest);
        Total = dot(Weights, 1.0);
    }

    float4 Fog = FogVolume.SampleLevel(LinearSampler, (Base + float2(0.5, 1.5)) / Size, 0) * Weights.x;
    Fog += FogVolume.SampleLevel(LinearSampler, (Base + float2(1.5, 1.5)) / Size, 0) * Weights.y;
    Fog += FogVolume.SampleLevel(LinearSampler, (Base + float2(1.5, 0.5)) / Size, 0) * Weights.z;
    Fog += FogVolume.SampleLevel(LinearSampler, (Base + float2(0.5, 0.5)) / Size, 0) * Weights.w;
    return Fog / Total;
}
